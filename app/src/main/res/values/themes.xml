<resources>
    <!-- Base application theme. -->
    <style name="Theme.Compound" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <!-- Keep content and surfaces paired for readable text in either system theme. -->
        <item name="colorSurface">@color/compoundSurface</item>
        <item name="colorOnSurface">@color/compoundOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/compoundOnSurfaceVariant</item>
        <item name="android:textColorPrimary">@color/compoundOnSurface</item>
        <item name="android:textColorSecondary">@color/compoundOnSurfaceVariant</item>
    </style>


    <style name="Theme.Compound.Fullscreen" parent="Theme.Compound">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>
